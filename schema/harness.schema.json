{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/harness.schema.json",
  "title": "Harness configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "neon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urlFile": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string"
        },
        "dailySummaryFilename": {
          "type": "string"
        }
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "stateFile": {
          "type": "string"
        }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "path"],
            "properties": {
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "closeSessionReminder": {
          "type": "string"
        }
      }
    },
    "orch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementer"],
      "properties": {
        "defaultRounds": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "implementer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokenFile"],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "default": "cursor-agent"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "default": "cursor-grok-4.6-high-fast"
            },
            "tokenFile": {
              "type": "string",
              "minLength": 1
            },
            "tokenEnvVar": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "default": "CURSOR_API_KEY"
            },
            "workerPattern": {
              "type": "string",
              "minLength": 1,
              "default": "cursor-agent/versions/.*worker-server"
            }
          }
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "default": "codex"
            },
            "effort": {
              "type": "string",
              "minLength": 1,
              "default": "high"
            }
          }
        }
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aptPackages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeMinVersion": {
          "type": "number",
          "minimum": 1
        },
        "requiredEnvVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalEnvVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "npmGlobalPackages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "authEnvVar": {
              "type": "string"
            },
            "workspaceWrite": {
              "type": "boolean"
            },
            "trustRepo": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buildTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
