{
  "$schema": "./.claude/_core/schema/harness.schema.json",
  "project": {
    "name": "your-project",
    "displayName": "Your Project"
  },
  "neon": {
    "urlFile": "~/.ssh/neon-harness-index-url.txt",
    "limit": 10
  },
  "sessions": {
    "dir": "_sessions",
    "dailySummaryFilename": "daily_summary.md"
  },
  "mirror": {
    "enabled": false
  },
  "canonical": {
    "links": [
      { "label": "AGENTS.md", "path": "AGENTS.md" },
      { "label": "README", "path": "README.md" },
      {
        "label": "Harness Constitution",
        "path": ".claude/_core/docs/harness_constitution.md"
      }
    ]
  },
  "orch": {
    "defaultRounds": 3,
    "implementer": {
      "command": "cursor-agent",
      "model": "cursor-grok-4.6-high-fast",
      "tokenFile": "~/.config/your-project/implementer-token",
      "tokenEnvVar": "CURSOR_API_KEY",
      "workerPattern": "cursor-agent/versions/.*worker-server"
    },
    "reviewer": {
      "command": "codex",
      "effort": "high"
    }
  },
  "cloud": {
    "aptPackages": ["build-essential", "bubblewrap"],
    "nodeMinVersion": 20,
    "requiredEnvVars": [],
    "optionalEnvVars": ["FORGEJO_TOKEN", "CODEX_AUTH_JSON"],
    "npmGlobalPackages": ["@openai/codex"],
    "codex": {
      "enabled": true,
      "authEnvVar": "CODEX_AUTH_JSON",
      "workspaceWrite": true,
      "trustRepo": true
    }
  },
  "install": {
    "buildTargets": []
  }
}
