# harness-core: モデル ID とペルソナ別既定の一元表(役員 人見 2026-09-24 裁定 A1/A2)。
#
# 世代交代のたびに直すのはこのファイルだけにする。実体を指す変数は 08-11 の裁定どおり
# 別名(opus/sonnet 等)を使わず ID で固定する。各ランチャは自分の CORE 解決の直後に
#   source "$CORE/scripts/models.env"
# で読み込み、既存の CLI 引数 / env 上書き口(KASHIWAGI_MODEL・KASHIWAGI_EFFORT・
# MAKABE_MODEL・MAKABE_EFFORT・--model・--effort など)はそのまま残す ── この表が
# 上書きされていないときの「素の既定値」を持つだけで、ランチャ側の上書き経路は変えない。
#
# 読み方は 2 通り:
#   bash から: `source scripts/models.env`(単純な代入、値が要る変数はここで export しない)
#   python から: `bash -c 'set -a; source scripts/models.env; set +a; env'` で解決した env を読む
#     (ここに書いた `${VAR:-...}` 形の代入を python 側で再実装しない)
#
# effort の値は今の挙動をそのまま写しただけ(贄川 high・柏木 xhigh・真壁 max など)。
# 値を変えるのは別の裁定 ── 今回はこのファイルと素の env で上書きできる口を作るだけ。

# ── 実体 ID(世代が上がったらここだけ直す)──
CLAUDE_OPUS_MODEL="claude-opus-5-5"
CLAUDE_SONNET_MODEL="claude-sonnet-5"
CODEX_LUNA_MODEL="gpt-6-luna"
CODEX_SOL_MODEL="gpt-6-sol"
CODEX_ASTRA_MODEL="gpt-6-astra"
GEMINI_MODEL="gemini-3.8-flash-high"
KIMI_MODEL="kimi-code/k3-256k"

# ── persona 別既定(model)。呼び出し前に env で個別に上書きできる ──
MINASE_MODEL="${MINASE_MODEL:-$CLAUDE_OPUS_MODEL}"                 # 水無瀬(claude-minase.sh)
NIEKAWA_CLAUDE_MODEL="${NIEKAWA_CLAUDE_MODEL:-$CLAUDE_OPUS_MODEL}"  # 贄川(claude 経路、claude-niekawa.sh 自身のエンジン)
NIEKAWA_CODEX_MODEL="${NIEKAWA_CODEX_MODEL:-$CODEX_SOL_MODEL}"      # 贄川(codex sol フォールバック、codex-agent.sh niekawa)
KASHIWAGI_OPUS_MODEL="${KASHIWAGI_OPUS_MODEL:-$CLAUDE_OPUS_MODEL}"  # 柏木(実行経路 C、claude-kashiwagi.sh 既定)
KASHIWAGI_CODEX_MODEL="${KASHIWAGI_CODEX_MODEL:-$CODEX_ASTRA_MODEL}" # 柏木(codex 経路、codex-agent.sh kashiwagi 既定)
MAKABE_CODEX_MODEL="${MAKABE_CODEX_MODEL:-$CODEX_LUNA_MODEL}"       # 真壁(codex 経路、codex-agent.sh makabe 既定)
MAKABE_CLAUDE_MODEL="${MAKABE_CLAUDE_MODEL:-$CLAUDE_SONNET_MODEL}"  # 真壁(claude 経路、claude-makabe.sh 固定エンジン)
ANNO_MODEL="${ANNO_MODEL:-$CLAUDE_SONNET_MODEL}"                    # 庵野(agents/anno.md の frontmatter と一致させる値)

# ── persona 別既定(effort)。今の挙動のままの値、上書きは env で ──
NIEKAWA_CLAUDE_EFFORT="${NIEKAWA_CLAUDE_EFFORT:-high}"      # claude-niekawa.sh(--effort は記録のみ、実際に渡すのはこの値)
NIEKAWA_CODEX_EFFORT="${NIEKAWA_CODEX_EFFORT:-high}"        # codex-agent.sh niekawa 既定(役員 人見 09-13)
KASHIWAGI_OPUS_EFFORT="${KASHIWAGI_OPUS_EFFORT:-xhigh}"     # claude-kashiwagi.sh 既定(役員 人見 2026-09-21 23:55)
KASHIWAGI_CODEX_EFFORT="${KASHIWAGI_CODEX_EFFORT:-high}"    # codex-agent.sh kashiwagi 既定(役員 人見 09-13)
MAKABE_CODEX_EFFORT="${MAKABE_CODEX_EFFORT:-max}"           # codex-agent.sh makabe 既定(役員 人見 09-13)
MAKABE_CLAUDE_EFFORT="${MAKABE_CLAUDE_EFFORT:-high}"        # claude-makabe.sh 既定
MINASE_CODEX_EFFORT="${MINASE_CODEX_EFFORT:-high}"          # codex-agent.sh minase 既定(役員 人見 09-13)

# ── ゲート 2 の P0 を直す巡・codex-niekawa の sol は CODEX_SOL_MODEL をそのまま使う(専用の別名は持たない)
